# ─── Contact form (Resend) ───────────────────────────────────────────────
# Create a key at https://resend.com/api-keys
# Until this is set, the contact form works but does NOT send email.
RESEND_API_KEY=
# Where contact messages are delivered (falls back to monicaparroyo7@gmail.com)
CONTACT_TO=
# Verified sender. Use Resend's test sender until you verify a domain.
CONTACT_FROM="Portfolio <onboarding@resend.dev>"

# ─── Sanity (blog) ───────────────────────────────────────────────────────
# From your Sanity project (sanity.io → project → API / settings).
# projectId + dataset are safe to expose (NEXT_PUBLIC_). Public dataset needs
# no token; for a private dataset add a read token.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Optional — only if your dataset is private.
SANITY_API_READ_TOKEN=
