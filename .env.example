# ─── Contact form (Resend) ───────────────────────────────────────────────
# Create a key at https://resend.com/api-keys
# Until this is set, the contact form works but does NOT send email.
RESEND_API_KEY=
# Where contact messages are delivered (falls back to monicaparroyo7@gmail.com)
CONTACT_TO=
# Verified sender. Use Resend's test sender until you verify a domain.
CONTACT_FROM="Portfolio <onboarding@resend.dev>"

# ─── Contentful (blog) — used in a later phase ───────────────────────────
# From Settings → API keys of your NEW, dedicated portfolio Space.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=
CONTENTFUL_ENVIRONMENT=master
